# 開發環境設定。複製為 .env 後依實際情況調整。
#
# 資料庫有兩種選擇：
#   本機 PostgreSQL  啟動快、可用既有工具管理，但版本與正式環境可能不同
#   容器 PostgreSQL  與 On-premise 交付一致，但需 Docker 常駐
#
# 預設為本機。切換到容器時改用註解掉的那組。

# ── 本機 PostgreSQL（預設）────────────────────────────
DATABASE_URL=postgres://workflow_app:app_dev_only@localhost:5432/workflow
ADMIN_DATABASE_URL=postgres://localhost:5432/workflow

# ── 容器 PostgreSQL ──────────────────────────────────
# DATABASE_URL=postgres://workflow_app:app_dev_only@localhost:5433/workflow
# ADMIN_DATABASE_URL=postgres://app:app_dev_only@localhost:5433/workflow

# ── API ──────────────────────────────────────────────
JWT_SECRET=dev-secret-at-least-32-bytes-long!!
PORT=3001
RUST_LOG=info,sqlx=warn

# ── 前端 ─────────────────────────────────────────────
VITE_API_BASE_URL=/api

# ── Temporal ─────────────────────────────────────────
# 連不上時 API 仍會啟動，流程執行相關端點回 503，其餘功能不受影響
TEMPORAL_TARGET=http://localhost:7233
TEMPORAL_NAMESPACE=default
# Python Worker 監聽的佇列，需與 python-ai/worker.py 一致
TEMPORAL_TASK_QUEUE=workflow-platform
# internal API 的共享密鑰。Python Worker 用它呼叫 /internal/*。
# 未設定時 internal API 停用，流程會停在第一個人工節點。
# 這組端點信任呼叫端宣稱的 tenant_id，絕不可暴露到公網。
INTERNAL_API_TOKEN=dev-internal-token-change-in-production

# ── SMTP（通知與提醒）─────────────────────────────────
# Gmail 需使用「應用程式密碼」而非登入密碼：
#   https://myaccount.google.com/apppasswords
# 未設定 SMTP_HOST 時通知功能停用，僅記稽核（開發時的預設行為）。
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=應用程式密碼，絕不可進版控
# SMTP_FROM=workflow@yourcompany.com
