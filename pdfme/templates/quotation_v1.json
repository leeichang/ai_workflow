        "width": 80,
        "height": 22,
        "fontSize": 9,
        "lineHeight": 1.5
      },

      {
        "_comment": "明細表。repeatHead 與 columnStyles.alignment 為官方支援；keepLastRowsTogether 由 table-plus 提供。",
        "name": "items",
        "type": "table",
        "position": { "x": 15, "y": 72 },
        "width": 180,
        "height": 40,
        "showHead": true,
        "repeatHead": true,
        "keepLastRowsTogether": 3,
        "head": ["品名", "數量", "單位", "單價", "金額"],
        "headWidthPercentages": [44, 12, 10, 16, 18],
        "content": "[]",
        "tableStyles": { "borderColor": "#D1D5DB", "borderWidth": 0.1 },
        "headStyles": {
          "fontName": "NotoSansCJKtc-Bold",
          "fontSize": 9,
          "alignment": "center",
          "verticalAlignment": "middle",
          "lineHeight": 1.3,
          "characterSpacing": 0,
          "fontColor": "#111827",
          "backgroundColor": "#F3F4F6",
          "borderColor": "#D1D5DB",
          "borderWidth": { "top": 0.1, "right": 0.1, "bottom": 0.1, "left": 0.1 },
          "padding": { "top": 2, "right": 2, "bottom": 2, "left": 2 }
        },
        "bodyStyles": {
          "fontName": "NotoSansCJKtc-Regular",
          "fontSize": 9,
          "alignment": "left",
          "verticalAlignment": "middle",
          "lineHeight": 1.3,
          "characterSpacing": 0,
          "fontColor": "#111827",
          "backgroundColor": "",
          "alternateBackgroundColor": "#FAFAFA",
          "borderColor": "#E5E7EB",
          "borderWidth": { "top": 0.1, "right": 0.1, "bottom": 0.1, "left": 0.1 },
          "padding": { "top": 2, "right": 2, "bottom": 2, "left": 2 }
        },
        "columnStyles": {
          "alignment": { "0": "left", "1": "right", "2": "center", "3": "right", "4": "right" }
        },
        "rowStyles": [
          {
            "_comment": "小計：與明細之間加分隔線",
            "fromEnd": 2,
            "borderTopWidth": 0.4,
            "borderColor": "#111827"
          },
          {
            "_comment": "總計：粗體放大",
            "fromEnd": 0,
            "fontName": "NotoSansCJKtc-Bold",
            "fontSize": 11
          }
        ]
      },

      {
