{
  "workflow_key": "quotation_approval",
  "version": 1,
  "business_object": "quotation",
  "name": "報價單簽核流程",
  "description": "業務發起，主管簽核，折扣超過 15% 加簽財務，送客戶簽核，接受後建立 Odoo 訂單",
  "trigger": { "type": "form_submit" },
  "nodes": [
    { "id": "start", "type": "trigger", "label": "業務送出報價單" },

    {
      "id": "manager_approval",
      "type": "human_approval",
      "label": "主管簽核",
      "participant": "internal",
      "resolver": { "type": "manager_of", "of": "initiator" },
      "timeout": {
        "after": "P2D",
        "policy": "ESCALATE",
        "to": { "type": "role", "value": "sales_director" }
      },
      "on_reject": { "action": "goto", "node": "revise" }
    },

    {
      "id": "discount_gate",
      "type": "condition",
      "label": "折扣是否超過 15%",
      "expression": "quotation.discount_rate > 0.15"
    },

    {
      "id": "finance_approval",
      "type": "human_approval",
      "label": "財務簽核",
      "participant": "internal",
      "resolver": { "type": "role", "value": "finance_manager" },
      "timeout": { "after": "P2D", "policy": "WAIT" },
      "on_reject": { "action": "goto", "node": "revise" }
    },

    {
      "id": "publish_to_customer",
      "type": "action",
      "label": "產生 PDF 並寄給客戶",
      "action": "quotation.publish",
      "idempotency_key": "{{instance.id}}:{{node.id}}:{{quotation.current_version}}",
      "retry": { "max_attempts": 3, "backoff": "exponential" }
    },

    {
      "id": "customer_review",
      "type": "human_approval",
      "label": "客戶簽核",
      "participant": "external",
      "resolver": { "type": "external_contacts", "path": "quotation.customer_contact_ids" },
      "join": { "completion": "ALL", "result": "ALL_SUCCESS" },
      "timeout": {
        "after": "P7D",
        "policy": "ESCALATE",
        "to": { "type": "initiator" }
      },
      "on_reject": { "action": "goto", "node": "revise" }
    },

    {
      "id": "revise",
      "type": "human_task",
      "label": "業務修改報價",
      "participant": "internal",
      "assignee": { "type": "initiator" }
    },

    {
      "id": "create_order",
      "type": "action",
      "label": "Odoo 建立訂單",
      "action": "odoo.create_sale_order",
      "idempotency_key": "{{instance.id}}:{{node.id}}",
      "retry": { "max_attempts": 5, "backoff": "exponential" },
      "on_failure": { "action": "goto", "node": "revise" }
    },

    {
      "id": "notify_done",
      "type": "notification",
      "label": "通知雙方完成",
      "channel": ["email"],
      "to": ["initiator", "quotation.customer_contact_ids"],
      "template_key": "quotation_ordered"
    },

    { "id": "end", "type": "end", "label": "完成", "result": "completed" }
  ],
  "edges": [
    ["start", "manager_approval"],
    ["manager_approval", "discount_gate"],
    ["discount_gate", "finance_approval", { "when": true, "label": "折扣 > 15%" }],
    ["discount_gate", "publish_to_customer", { "when": false, "label": "折扣 <= 15%" }],
    ["finance_approval", "publish_to_customer"],
    ["publish_to_customer", "customer_review"],
    ["customer_review", "create_order"],
    ["revise", "manager_approval"],
    ["create_order", "notify_done"],
    ["notify_done", "end"]
  ]
}
